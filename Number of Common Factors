
#include <iostream>
using namespace std;

class Solution {
public:
    int commonFactors(int a, int b) {
        int count = 0;

        for (int i = 1; i <= min(a, b); i++) {
            if (a % i == 0 && b % i == 0) {
                count++;
            }
        }

        return count;
    }
};

int main() {
    int a = 12;
    int b = 6;

    Solution s;

    cout << "Common Factors: "
         << s.commonFactors(a, b) << endl;

    return 0;
}
