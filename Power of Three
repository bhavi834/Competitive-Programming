
#include <iostream>
using namespace std;

class Solution {
public:
    bool isPowerOfThree(int n) {
        if (n < 1) {
            return false;
        }

        while (n % 3 == 0) {
            n /= 3;
        }

        return n == 1;
    }
};

int main() {
    int n = 27;

    Solution s;
    cout << (s.isPowerOfThree(n) ? "true" : "false")
         << endl;

    return 0;
}
