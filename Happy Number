
#include <iostream>
using namespace std;

class Solution {
public:
    int digitSquareSum(int n) {
        int sum = 0;

        while (n > 0) {
            int digit = n % 10;
            sum += digit * digit;
            n /= 10;
        }

        return sum;
    }

    bool isHappy(int n) {
        int slow = n;
        int fast = n;

        do {
            slow = digitSquareSum(slow);
            fast = digitSquareSum(digitSquareSum(fast));
        } while (slow != fast);

        return slow == 1;
    }
};

int main() {
    int n = 19;

    Solution sol;
    cout << (sol.isHappy(n) ? "true" : "false") << endl;

    return 0;
}
