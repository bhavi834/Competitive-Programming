
#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:
    int singleNumber(vector<int>& nums) {
        int result = 0;

        for (int x : nums) {
            result ^= x;
        }

        return result;
    }
};

int main() {
    vector<int> nums = {4, 1, 2, 1, 2};

    Solution s;
    cout << s.singleNumber(nums) << endl;

    return 0;
}
