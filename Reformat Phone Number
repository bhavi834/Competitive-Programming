
#include <iostream>
#include <string>
using namespace std;

class Solution {
public:
    string reformatNumber(string number) {
        string digits = "";

        for (char c : number) {
            if (c >= '0' && c <= '9') {
                digits += c;
            }
        }

        string result;
        int i = 0;
        int n = digits.size();

        while (n - i > 4) {
            result += digits.substr(i, 3);
            result += "-";
            i += 3;
        }

        int remaining = n - i;

        if (remaining == 4) {
            result += digits.substr(i, 2);
            result += "-";
            result += digits.substr(i + 2, 2);
        } else if (remaining > 0) {
            result += digits.substr(i, remaining);
        }

        return result;
    }
};

int main() {
    string number = "1-23-45 6";

    Solution s;
    cout << s.reformatNumber(number) << endl;

    return 0;
}
